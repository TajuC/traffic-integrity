# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Canonical public origin of the site (https in production) and any extra origins that serve the same app
PUBLIC_ORIGIN=https://www.example.com
ALLOWED_ORIGINS=https://example.com

# Required. At least 32 characters of random data, for example: openssl rand -base64 48
# Rotation: move the current value to INTEGRITY_SECRET_PREVIOUS and set a new INTEGRITY_SECRET
INTEGRITY_SECRET=
INTEGRITY_SECRET_PREVIOUS=

# Shared counters, replay guards and restrictions. Required when more than one instance serves traffic
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=ti:
REDIS_COMMAND_TIMEOUT_MS=150

# Required in production. pglite://memory or pglite://./data/dev-db is accepted for local development only
DATABASE_URL=postgres://traffic:password@127.0.0.1:5432/traffic
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Hops allowed to set X-Forwarded-For: loopback, private, or explicit IPs/CIDRs of your reverse proxy or load balancer
TRUSTED_PROXIES=loopback

# off | monitor | enforce. enforce rejects any request that did not come through your Cloudflare zone
CLOUDFLARE_MODE=off
# Static value set by a Cloudflare request header Transform Rule as x-edge-auth. Required for CLOUDFLARE_MODE=enforce
# and for trusting any Cloudflare signal header. During rotation list the new and the old value separated by a comma
CLOUDFLARE_EDGE_SECRET=

# Cloudflare Turnstile widget keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_MS=2500
TURNSTILE_MAX_AGE_SECONDS=300

# monitor logs decisions without acting on them; switch to enforce after the tuning period
ENFORCEMENT_MODE=monitor
# Optional JSON file overriding any part of the risk policy
RISK_POLICY_PATH=
RISK_MONITOR_THRESHOLD=
RISK_CHALLENGE_THRESHOLD=
RISK_RESTRICT_THRESHOLD=
RISK_BLOCK_THRESHOLD=

# Network intelligence produced by npm run intel:refresh, plus an optional ASN database in MMDB format
NETWORK_INTEL_PATH=data/network-intel.json
ASN_DATABASE_PATH=
CRAWLER_REVERSE_DNS=true

# Routing
INTERNAL_PATH_PREFIX=/_ti
API_PREFIXES=/api/
SENSITIVE_ACTION_PATHS=
BYPASS_PATHS=/healthz,/readyz,/robots.txt,/favicon.ico,/sitemap.xml
VISITOR_COOKIE_DAYS=180

# Lead and conversion pipeline
LEAD_PATH=/api/leads
FORM_IDS=contact,quote
CONVERSION_CHALLENGE=always
CONVERSION_ACTION_NAME=Qualified lead
CONVERSION_VALUE=
CONVERSION_CURRENCY=USD
CONVERSION_HOLD_MINUTES=120
CONVERSION_BURST_PER_HOUR=30
CONVERSION_TIMEZONE=UTC
FORM_HONEYPOT_FIELD=company_website
PHONE_COUNTRY_CODE=

# Basic auth credentials Google Ads uses to fetch the scheduled conversion upload over HTTPS
EXPORT_USERNAME=
EXPORT_PASSWORD=

# Bearer token for metrics and admin endpoints. At least 32 characters
ADMIN_TOKEN=

# Observability and retention
LOG_LEVEL=info
ASSESSMENT_LOG_SAMPLE_RATE=0.02
PAID_VISIT_RETENTION_DAYS=90
ATTEMPT_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=365
